.stage{perspective:1100px}
.book{position:relative;width:min(62vw,270px);aspect-ratio:3/4.1;transform-style:preserve-3d;transform:rotateY(-14deg) rotateX(4deg);transition:transform 1.4s;cursor:pointer;animation:fl 4s ease-in-out infinite}
