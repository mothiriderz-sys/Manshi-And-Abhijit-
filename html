.sl{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;width:100%;scrollbar-width:none;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
.sl::-webkit-scrollbar{display:none}
.sl>*{flex:0 0 100%;scroll-snap-align:center}
.cs{padding:20px 0;perspective:900px}.cs>*{flex-basis:76%;margin:0 2%;}.cs:before,.cs:after{content:"";flex:0 0 10%}
