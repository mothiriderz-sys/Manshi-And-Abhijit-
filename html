.cov{position:absolute;inset:0;transform-origin:left center;transition:transform 1.5s cubic-bezier(.6,0,.3,1);border-radius:3px 12px 12px 3px;backface-visibility:hidden;background:radial-gradient(circle at 30% 25%,#9a3047,#6e1f2f 55%,#4a1020),repeating-linear-gradient(45deg,rgba(255,255,255,.04) 0 2px,transparent 2px 5px);box-shadow:-6px 0 0 #4a1020,0 22px 40px rgba(90,20,40,.45);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--g);text-align:center}
