.gar{position:absolute;top:0;left:0;right:0;height:34px;z-index:2;background:radial-gradient(circle at 13px 11px,#f9b233 0 7px,#e8800c 8px 11px,transparent 12px) 0 0/26px 34px repeat-x;filter:drop-shadow(0 2px 2px rgba(0,0,0,.2))}
