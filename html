.dots{display:flex;gap:8px;justify-content:center;margin-top:10px}.dots b{width:8px;height:8px;border-radius:50%;background:rgba(212,175,106,.4);transition:.3s}.dots b.on{background:var(--g);width:22px;border-radius:5px}
