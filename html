.cov .om{width:60px;height:60px;font-size:32px;background:rgba(0,0,0,.15)}
.tap{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--w);animation:pu 1.8s infinite}
@keyframes pu{50%{opacity:.35}}
#petals{position:fixed;inset:0;z-index:60;pointer-events:none;overflow:hidden}
.pt{position:absolute;top:-30px;width:12px;height:16px;border-radius:70% 0 70% 0;background:linear-gradient(135deg,#f4a6b4,#c0304f);opacity:.85;animation:fall linear forwards}
.pt.m{background:linear-gradient(135deg,#ffc34d,#f08a0c)}
@keyframes fall{to{transform:translate(var(--x),108vh) rotate(var(--r))}}
/* p2 */
.bgp{position:absolute;inset:-6%;background:url(data:image/jpeg;base64,) center 18%/cover;filter:blur(3px);animation:zm 22s ease-in-out infinite alternate}
@keyframes zm{to{transform:scale(1.12)}}
.veil{position:absolute;inset:0;background:linear-gradient(rgba(255,248,238,.86),rgba(250,226,226,.9))}
.nm{font-size:clamp(40px,12vw,54px);line-height:1.05}
.par{font-size:11px;line-height:1.5;margin:2px auto 0;max-width:290px}
.amp{font-size:30px;font-style:italic;margin:4px 0}
.msg{font-size:11px;line-height:1.65;max-width:310px;margin-top:10px;font-weight:300}
/* p3 scroll */
.rod{width:min(86vw,330px);height:16px;border-radius:8px;background:linear-gradient(#f3dc9b,#b88a3b);position:relative;box-shadow:0 4px 8px rgba(0,0,0,.25)}
.scr{width:min(80vw,310px);max-height:0;overflow:hidden;background:linear-gradient(90deg,#f3e2b9,#fff6dd 50%,#f3e2b9);transition:max-height 2s ease;border-left:2px solid var(--g);border-right:2px solid var(--g);color:var(--w)}
.scr.open{max-height:600px}.cdn{display:flex;justify-content:center;gap:8px;margin:10px 0 8px}.cdn div{min-width:52px;padding:6px 4px;border:1px solid var(--g);border-radius:8px;background:rgba(110,31,47,.07)}.cdn b{display:block;font:500 18px 'Playfair Display',serif}.cdn span{font-size:8.5px;letter-spacing:.14em;text-transform:uppercase}
.scr>div{padding:14px 14px 18px}
.rings{height:70px;perspective:500px}.rings .rg{animation:sp3 6s linear infinite}
@keyframes sp3{to{transform:rotateY(360deg)}}
.tas{position:absolute;right:26px;top:14px;width:2px;height:70px;background:var(--g);cursor:grab;touch-action:none;transition:height .3s}
.tas::after{content:"";position:absolute;left:-8px;bottom:-26px;width:18px;height:30px;background:linear-gradient(#c0304f,#6e1f2f);border-radius:4px 4px 9px 9px;box-shadow:0 0 0 2px var(--g)}
.fng{position:absolute;right:12px;top:96px;font-size:32px;animation:pl 1.6s ease-in-out infinite}
@keyframes pl{50%{transform:translateY(16px)}}
.dt{font-size:12px;line-height:1.7;margin-top:6px}.dt b{font-family:'Playfair Display',serif;font-size:15px;display:block;font-weight:500}
.ph{border:2px solid var(--g);border-radius:12px;box-shadow:0 0 22px rgba(212,175,106,.75),0 0 0 5px rgba(212,175,106,.2);overflow:hidden;animation:gl 3.5s ease-in-out infinite}
