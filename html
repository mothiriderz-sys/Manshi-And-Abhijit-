.toast{position:fixed;left:50%;bottom:40px;transform:translateX(-50%);background:var(--w);color:var(--iv);padding:10px 18px;border-radius:20px;font-size:12px;opacity:0;transition:.4s;z-index:99;pointer-events:none}.toast.s{opacity:1}
