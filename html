.main{height:100%;overflow-y:auto;scroll-snap-type:y mandatory;scroll-behavior:smooth}
.pg{height:100svh;min-height:560px;scroll-snap-align:start;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:calc(env(safe-area-inset-top,0px) + 40px) 26px calc(env(safe-area-inset-bottom,0px) + 22px)}
.pg::before{content:"";position:absolute;inset:10px;border:1px solid var(--g);border-radius:14px;box-shadow:inset 0 0 0 5px transparent,inset 0 0 0 6px rgba(212,175,106,.45);pointer-events:none;z-index:3}
.blush{background:radial-gradient(circle at 50% 30%,#fff8ee,#f6d9d9 80%)}
