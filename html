/* intro book */
#intro{position:fixed;inset:0;z-index:50;background:radial-gradient(circle at 50% 40%,#fff3ee,#f4cfd3 85%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:34px;transition:opacity 1.2s;overflow:hidden}
