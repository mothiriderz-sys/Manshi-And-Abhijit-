<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
$$('.sp').forEach(e=>{for(let i=0;i<14;i++){const s=document.createElement('i');s.style.cssText=`left:${Math.random()*96}%;top:${Math.random()*96}%;animation-delay:${Math.random()*3.2}s;scale:${.6+Math.random()*.9}`;e.appendChild(s)}});
function petals(n,ms){const L=$('#petals');const t=setInterval(()=>{const p=document.createElement('div');p.className='pt'+(Math.random()<.4?' m':'');p.style.cssText=`left:${Math.random()*100}%;--x:${Math.random()*120-60}px;--r:${Math.random()*600}deg;animation-duration:${4+Math.random()*4}s`;L.appendChild(p);setTimeout(()=>p.remove(),8500)},ms/n);setTimeout(()=>clearInterval(t),ms)}
let opened=false;
const au=$('#bgm'),mb=$('#mus');let fade,want=true;
function fadeTo(v,ms){clearInterval(fade);const s=au.volume,st=20,dv=(v-s)/(ms/st);fade=setInterval(()=>{let x=au.volume+dv;if((dv>0&&x>=v)||(dv<=0&&x<=v)){x=v;clearInterval(fade);if(v===0)au.pause()}au.volume=Math.max(0,Math.min(1,x))},st)}
function startMusic(){au.volume=0;au.play().then(()=>{fadeTo(.4,3000);mb.style.display='block';mb.textContent='♪';mb.style.opacity=1}).catch(()=>{mb.style.display='block';mb.style.opacity=.55;want=false})}
mb.addEventListener('click',()=>{if(au.paused){want=true;au.volume=0;au.play().then(()=>{fadeTo(.4,1200);mb.style.opacity=1})}else{want=false;fadeTo(0,500);mb.style.opacity=.55}});
document.addEventListener('visibilitychange',()=>{if(document.hidden){au.pause()}else if(want&&au.paused&&opened){au.play().catch(()=>{})}});

const intro=$('#intro');
intro.addEventListener('click',()=>{if(opened)return;opened=true;startMusic();intro.classList.add('op');petals(45,6000);
setTimeout(()=>{pgs[0].classList.add('in');[...nav.children].forEach((b,i)=>b.classList.toggle('on',i===0))},1700);
setTimeout(()=>{intro.classList.add('out');setTimeout(()=>intro.remove(),1300)},3400)});
const pgs=$$('.pg'),nav=$('#nav');pgs.forEach(()=>nav.appendChild(document.createElement('b')));
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting&&(e.target!==pgs[0]||opened)){e.target.classList.add('in');nav.children.length&&[...nav.children].forEach((b,i)=>b.classList.toggle('on',pgs[i]===e.target))}}),{root:$('#main'),threshold:.6});
pgs.forEach(p=>io.observe(p));
function unroll(){if($('#scr').classList.contains('open'))return;$('#scr').classList.add('open');$('#fng').style.display='none';$('#tas').style.height='96px';petals(30,3500)}
const tas=$('#tas');let y0=null;
tas.addEventListener('pointerdown',e=>{y0=e.clientY;tas.setPointerCapture(e.pointerId)});
tas.addEventListener('pointermove',e=>{if(y0!==null&&e.clientY-y0>24){y0=null;unroll()}});
tas.addEventListener('pointerup',()=>{if(y0!==null){y0=null;unroll()}});
$('#fng').addEventListener('click',unroll);$('#rod').addEventListener('click',unroll);
$$('.sl').forEach(sl=>{const k=[...sl.children].filter(c=>!c.matches('style')),d=sl.parentElement.querySelector('.dots');
k.forEach(()=>d.appendChild(document.createElement('b')));
const up=()=>{const c=sl.scrollLeft+sl.clientWidth/2;let b=0,m=1e9;k.forEach((el,i)=>{const dd=Math.abs(el.offsetLeft+el.offsetWidth/2-c);if(dd<m){m=dd;b=i}});k.forEach((el,i)=>el.classList.toggle('on',i===b));[...d.children].forEach((x,i)=>x.classList.toggle('on',i===b))};
sl.addEventListener('scroll',()=>requestAnimationFrame(up),{passive:true});up()});
const T=new Date('2026-12-06T00:00:00+05:30');function tick(){let d=T-Date.now();if(d<0)d=0;const v=[Math.floor(d/864e5),Math.floor(d/36e5)%24,Math.floor(d/6e4)%60,Math.floor(d/1e3)%60];['d','h','m','s'].forEach((k,i)=>{const e=$('#cd-'+k);if(e)e.textContent=String(v[i]).padStart(2,'0')})}tick();setInterval(tick,1000);
const ADDR='Narayanpur, PO Nuaguda, Via Padampur, District Rayagada, Odisha, India';
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('s');setTimeout(()=>e.classList.remove('s'),2000)}
$('#cp').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(ADDR)}catch(e){const a=document.createElement('textarea');a.value=ADDR;document.body.appendChild(a);a.select();try{document.execCommand('copy')}catch(_){}a.remove()}toast('Address copied')});
